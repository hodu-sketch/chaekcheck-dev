{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "web-lan",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort",
        "--host"
      ],
      "port": 5173
    },
    {
      "name": "web-lan-5174",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort",
        "--host"
      ],
      "port": 5174
    },
    {
      "name": "web-tunnel-5175",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=.trycloudflare.com&& npm --prefix web run dev -- --port 5175 --strictPort"
      ],
      "port": 5175
    },
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "backend\\gradlew.bat -p backend bootRun"
      ],
      "port": 8080
    },
    {
      "name": "backend-no-login",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "backend\\gradlew.bat -p backend bootRun --args=--chaekcheck.auth.enabled=false"
      ],
      "port": 8080
    }
  ]
}
