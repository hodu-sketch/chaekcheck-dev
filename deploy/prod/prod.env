# Settings that are not secret for the EC2 deployment (cycle 17, ADR-0103). up.sh passes this file to compose after
# secrets.env. Change a value here, copy the file to /srv/chaekcheck/prod.env and `bin/switch.sh backend <current version>` (zero-downtime).

# Address users open the site with; Kakao redirect URI = <this>/api/v1/auth/login/oauth2/code/kakao
AUTH_PUBLIC_BASE_URL=https://chaekcheck.com

# Go-live switches (plan 17, user decision 2026-10-18: login and the usage log go on with the tunnel, the opening day).
CHAEKCHECK_AUTH_ENABLED=true
CHAEKCHECK_USAGELOG_ENABLED=true
# AI book search (cycle 24). Turn on only after: 1. the privacy policy version naming Anthropic is in force, 2. the
# key is in Parameter Store, 3. book-texts was put in (docs/maintenance/6-aisearch.md), then up.sh (handoff step 11).
# On from v1.10.0 (user 2026-10-25 "aws에 올려줘", privacy policy version 3).
CHAEKCHECK_AISEARCH_ENABLED=true

# 나에게 맞는 책 (cycle 23): no build of popular orders yet (user 2026-10-25 "수집 끄고 배포"); true turns on the build at
# start-up and every day at 03:30 (6 site pages through the Webshare proxies).
CHAEKCHECK_FORYOU_BUILD_ENABLED=false

# AI search question vectors (v1.15.0, user 2026-10-25 "임베딩 서버 방식으로 벡터 켜고"): the question becomes a vector
# on the embedding server (micro EC2 chaekcheck-embed, private address, embed-service), the book vectors are read from
# /srv/chaekcheck/aisearch-model/book-vectors.bin. The token is CHAEKCHECK_AISEARCH_EMBED_TOKEN in Parameter Store.
# encoder=local runs the model in the backend instead (the model files in the same folder; docs/maintenance/6-aisearch.md 7-1).
CHAEKCHECK_AISEARCH_VECTOR_ENABLED=true
CHAEKCHECK_AISEARCH_VECTOR_ENCODER=remote
CHAEKCHECK_AISEARCH_EMBED_URL=http://172.31.45.141:8090

# AI search first step (user 2026-10-26 "1차를 5갈래 MLP로 바꿔요(M4 방식)", docs/maintenance/6-aisearch.md 8절): ml = the
# way, the shelves and the words from the question vector, no first Haiku call; a question about 책첵 is answered from the
# site's text. Needs first-call-model.bin (and follow-up-model.bin) in /srv/chaekcheck/aisearch-model/ and the
# profiles in catalog.book_profile (book-profiles import, v1.22.1); without them the backend logs "the ml one is off"
# and uses Haiku. haiku turns it back.
CHAEKCHECK_AISEARCH_FIRST_CALL=ml
# Follow-ups under ml (user 2026-10-26, 6-aisearch.md 8절): relation = the relation network follow-up-model.bin in the
# model folder sorts a follow-up into 7 kinds (without the file the backend logs "follow-ups by rule"); rule = the
# v1.16.0 new-topic rule.
CHAEKCHECK_AISEARCH_FOLLOW_UP=relation
# AI search ask-back, thinking and prompt caching (user 2026-10-26 "되묻기 + 생각 끄기 + 캐시로 배포해줘", v1.17.0,
# docs/maintenance/6-aisearch.md 10절): the pick call asks back with choices when a question reads two ways and a
# not-book question gets a fixed ask-back; Haiku answers without its thinking step (first text 4.0 -> 2.3 s); the
# system prompt is cached. Empty / false turns each back.
CHAEKCHECK_AISEARCH_PICK_ASK_BACK=true
CHAEKCHECK_AISEARCH_LLM_THINKING=disabled
CHAEKCHECK_AISEARCH_LLM_CACHE_SYSTEM=true
