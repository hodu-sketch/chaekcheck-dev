# Copy to .env and fill in. .env is not committed.

# Local development database (compose service: db)
DB_NAME=chaekcheck
DB_USERNAME=chaekcheck
DB_PASSWORD=
DB_PORT=5432
# PostgreSQL memory (compose service db only; cycle 08, ADR-0066). Values measured on the local PC (WSL2, 32GB) with
# one step of margin; a container limit of 1GB fits them. Measure again on the production server.
DB_SHARED_BUFFERS=64MB
DB_EFFECTIVE_CACHE_SIZE=768MB
DB_WORK_MEM=4MB
# Production-role database for the separate import test (compose service db-ops, profile ops; cycle 11)
OPS_DB_PORT=5434

# Test database (compose service: db-test), used by ./gradlew test
TEST_DB_NAME=chaekcheck_test
TEST_DB_USERNAME=chaekcheck
TEST_DB_PASSWORD=
TEST_DB_PORT=5433

# Library page fetching (ADR-0015). direct (default) or fetch-service.
FETCH_MODE=direct
# Fetch server addresses, in priority order (main service side).
# TODO(확인 필요): how many fetch servers, where, fixed IPs.
FETCH_SERVER_1_URL=http://localhost:8091
FETCH_SERVER_2_URL=http://localhost:8092
# Shared token between the main service and the fetch servers (same value on both sides).
# TODO(확인 필요): where the token is kept in production.
FETCH_SERVICE_TOKEN=

# Login (cycle 05, ADR-0046). Off unless CHAEKCHECK_AUTH_ENABLED=true; the keys below are needed only then.
CHAEKCHECK_AUTH_ENABLED=false
# Providers on the login screen, comma separated: naver,kakao (default both). Keys are needed only for these.
AUTH_PROVIDERS=naver,kakao
# Address users open the site with (no trailing slash). Development: the Vite dev server, http://localhost:5173.
# Redirect URIs to register at Naver and Kakao: <this>/api/v1/auth/login/oauth2/code/{naver|kakao}
AUTH_PUBLIC_BASE_URL=
# JWT signing key: base64 of at least 32 random bytes (HS256)
AUTH_JWT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Kakao REST API key (= OAuth client id) and client secret
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# Kakao service app admin key: unlinks a Kakao account (abandoned sign-up, withdrawal, link check)
KAKAO_ADMIN_KEY=
# Kakao app number (app ID), checked on the unlink webhook
KAKAO_APP_ID=

# Librarian picks fetch (cycle 14). Default true; local development keeps it off. Set true only to try a fetch: it
# calls the real National Library of Korea API once plus the new covers (about 52), 1s apart.
CHAEKCHECK_PICKS_FETCH_ENABLED=false
# National Library of Korea Open API key (사서추천도서). A secret: put the value only in your .env, never commit it.
CHAEKCHECK_PICKS_NLK_API_KEY=
